# QuickBooks Webhooks Configuration Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git - the .env file is already in .gitignore

# ===== QuickBooks OAuth 2.0 Credentials =====
# Get these from: https://developer.intuit.com/app/developer/dashboard
# Select your app → Keys & OAuth

# REQUIRED: Your QuickBooks App credentials
QB_CLIENT_ID=your_client_id_here
QB_CLIENT_SECRET=your_client_secret_here

# REQUIRED: Your ngrok or public callback URL
# Example: https://yourapp.ngrok.io/callback
QB_REDIRECT_URI=https://your-ngrok-url.ngrok-free.app/callback

# ===== QuickBooks Environment =====
# Use "sandbox" for testing or "production" for live data
QB_ENVIRONMENT=sandbox

# ===== Webhooks Configuration =====
# Get verifier token from QuickBooks Webhooks dashboard
# Or generate your own UUID
WEBHOOKS_VERIFIER_TOKEN=your-webhook-verifier-token-here




